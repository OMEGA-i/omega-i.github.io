---
import {mediaUrl} from "../../media";

import MotionHero from "../../components/MotionHero.astro";
import EssayList from "../../components/EssayList.astro";

import Layout from "../../layouts/Layout.astro";
import { locales, projects, type Lang } from "../../content";
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang,
  en = lang === "en";
const layers = [
  {title: en?"Motion representation & generation":"动作表示与生成", group:projects.slice(0,2)},
  {title: en?"Physics-based tracking":"物理跟踪", group:projects.slice(2,3)},
  {title: en?"Interactive simulation & data production":"交互仿真与数据生产", group:projects.slice(3)},
];
---

<Layout lang={lang} title={en ? "Research" : "研究"}>
  <div class="wrap home">
    <MotionHero lang={lang} />
    <section id="projects" data-system aria-labelledby="research">
      <div class="sectionline" id="architecture">
        <h2 id="research">{en ? "Research projects" : "研究项目"}</h2>
      </div>
      <div class="research-layers plate">
      {layers.map(({title,group},level)=>(
        <section class="layer"><header><small>0{level+1}</small><h3>{title}</h3>
        {level===0 && <p>{en?"Joystick outputs robot motion. SeMoCo human motion passes through retargeting before tracking.":"Joystick 直接输出机器人参考动作。SeMoCo 生成的人体动作经重定向后可供机器人跟踪。"}</p>}</header>
        <div class="project-row">{group.map((p) => (
          <article class="project-shell">
            <a
              class={"project " + p.id}
              href={"/" + lang + "/projects/" + p.id + "/"}
            >
              <div class="imagebox">
                <img
                  src={mediaUrl("/previews/" + p.id + "-front.webp")}
                  alt={p.alt[en ? 0 : 1]}
                  width="700"
                  height="394"
                />
                <video
                  preload="none"
                  muted
                  playsinline
                  loop
                  data-src={mediaUrl(
                    p.id === "joystick"
                      ? "/joystick/diagonal.mp4"
                      : "/previews/" + p.id + ".mp4"
                  )}
                  aria-hidden="true"
                ></video>
              </div>
              <div class="projecttext">
                <div class="cardtitle">
                  <h3>{p.name}</h3>
                  <span aria-hidden="true">↗</span>
                </div>
                <p>{p.description[en ? 0 : 1]}</p>
              </div>
            </a>
            <button
              class="clip-toggle"
              type="button"
              aria-pressed="false"
              aria-label={
                en ? "Play " + p.name + " preview" : "播放 " + p.name + " 预览"
              }
              data-name={p.name}
            >
              <span aria-hidden="true">▶</span>
            </button>
          </article>
        ))}</div></section>))}
      </div>
    </section>

    <section class="homeblog">
      <div class="sectionline">
        <h2>{en ? "Research notes" : "研究笔记"}</h2>
        <a href={"/" + lang + "/blog/"}>{en ? "All articles" : "所有文章"} ↗</a>
      </div>
      <EssayList lang={lang} />
    </section>
  </div>
</Layout>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  const english = document.documentElement.lang === "en";
  const stops = new Set<() => void>();
  for (const shell of document.querySelectorAll<HTMLElement>(
    ".project-shell",
  )) {
    const video = shell.querySelector("video")!,
      toggle = shell.querySelector<HTMLButtonElement>(".clip-toggle")!;
    let pinned = false,
      revision = 0;
    function state(playing: boolean) {
      video.classList.toggle("active", playing);
      toggle.setAttribute("aria-pressed", String(playing));
      toggle.setAttribute(
        "aria-label",
        english
          ? (playing ? "Pause " : "Play ") + toggle.dataset.name + " preview"
          : (playing ? "暂停 " : "播放 ") + toggle.dataset.name + " 预览",
      );
      toggle.querySelector("span")!.textContent = playing ? "Ⅱ" : "▶";
    }
    function stop() {
      revision++;
      pinned = false;
      video.pause();
      state(false);
    }
    stops.add(stop);
    async function start() {
      for (const other of stops) if (other !== stop) other();
      const token = ++revision;
      if (!video.src) video.src = matchMedia("(max-width: 720px)").matches ? video.dataset.src!.replace(".mp4","-720.mp4") : video.dataset.src!;
      try {
        await video.play();
        if (token === revision) state(true);
      } catch {
        if (token === revision) stop();
      }
    }
    toggle.onclick = () => {
      if (!video.paused) {
        stop();
        return;
      }
      pinned = true;
      void start();
    };
    shell.onpointerenter = (e) => {
      if (e.pointerType === "mouse" && !reduce.matches) void start();
    };
    shell.onpointerleave = () => {
      if (!pinned) stop();
    };
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
    });
    reduce.addEventListener("change", () => {
      if (reduce.matches) stop();
    });
  }
</script>
<style>
.research-layers{background:var(--bg);border-bottom:1px solid var(--rule)}
.layer{display:grid;grid-template-columns:minmax(160px,1fr) 3fr;gap:clamp(16px,3vw,52px);border-top:1px solid var(--rule);padding:24px 0}
.layer header small{font:500 .8rem var(--mono);color:var(--accent)}
.layer header h3{margin:.45em 0;font-size:clamp(1.2rem,2vw,1.8rem);line-height:1.2}
.layer header p{color:var(--muted);font-size:.92rem;line-height:1.6}
.project-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
@media(min-width:721px){.project-row .project-shell:only-child{grid-column:span 2}.project-row .project-shell:only-child .project{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:center;gap:20px}.project-row .project-shell:only-child .clip-toggle{right:calc(50% + 22px)}}
@media(max-width:720px){.layer,.project-row{grid-template-columns:1fr}.layer{padding:20px 0}.layer header p{max-width:46ch}}

  .project-shell {
    position: relative;
    min-width: 0;
  }
  .project-shell .project {
    height: 100%;
  }
  .clip-toggle {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 44px;
    height: 44px;
    border: 1px solid #ffffff6b;
    background: #192a46dc;
    color: #fff;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 13px;
    cursor: pointer;
  }
  .clip-toggle:hover {
    background: #1d3976;
  }
  .clip-toggle span {
    line-height: 1;
  }
</style>
