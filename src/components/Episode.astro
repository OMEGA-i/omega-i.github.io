---
import LivePatrol from "./LivePatrol.astro";
import ModelSwitch from "./ModelSwitch.astro";
import run from "../../public/inspection/record.json";
import nativeA3 from "../../public/inspection/a3-record.json";
const en=Astro.props.lang==="en", t=(a:string,b:string)=>en?a:b;
const labels:Record<string,string>={
  inbound:t("Inbound stop complete","收货口停站完成"),bend:t("Enter cross aisle","进入横向通道"),
  clear:t("Rack cleared","绕过货架"),inventory:t("Inspection complete","库存区检查完成"),
  return_lane:t("Return aisle","进入返航通道"),dispatch:t("Dispatch stop complete","发货口停站完成"),
  dock:t("Back at dock","返回充电区")};
const px=(x:number)=>60+x*39, py=(y:number)=>199-y*39;
const itinerary=[[0,0],...run.route.map(r=>[Number(r[1]),Number(r[2])])];
labels.turn=t("Turn onset (+10°)","开始转向（+10°）");
function cues(record:typeof run){
  const start=Number(record.events[0][1]),initial=record.heading[Math.round(start*25)];
  const index=(test:(h:number)=>boolean)=>record.heading.findIndex((h,i)=>i/25>=start && test(h));
  const events=[...record.events];
  for(const [name,i] of [["turn",index(h=>h>=initial+10)],["aligned",index(h=>h>=75&&h<=105)]] as const){
    if(i>=0)events.push([name,i/25]);
  }
  return events.sort((a,b)=>Number(a[1])-Number(b[1]));
}
const milestones=cues(run);
const profiles=Object.fromEntries([run,nativeA3].map(r=>[r.robot,{
 duration:r.duration,cues:cues(r),samples:r.clearance.samples,contacts:r.clearance.rackContactSamples
}]));
const stations:Record<string,string>={inbound:t("Inbound","收货口"),clear:t("Past rack","绕过货架"),inventory:t("Inventory","库存区"),dispatch:t("Dispatch","发货口"),dock:t("Dock","充电区")};
labels.aligned=t("Facing the cross aisle","机身转入横向通道");
---
<section class="episode" data-episode data-profiles={JSON.stringify(profiles)} data-labels={JSON.stringify(labels)} data-stations={JSON.stringify(stations)} data-lang={en?"en":"zh"}>
<header><div><p data-kind>{t("G1 · Recorded physics trial","G1 · 物理执行记录")}</p><h2>{t("A warehouse inspection","一次仓内巡检")}</h2></div>
<div class="view-controls"><ModelSwitch control="data-model-choice" label={en?"Playback model":"回放本体"}  />
<label>{t("Camera","机位")}<select aria-label={t("Observation","观测方式")} data-angle>{(en?["Third person","First person + map","Depth · 0–8 m","Ground track","All observations"]:["第三人称","第一视角 + 地图","深度 · 0–8 m","地面轨迹","全部观测"]).map((v,i)=><option value={i} selected={i===1}>{v}</option>)}</select></label></div></header>
<LivePatrol lang={en?"en":"zh"}/>
<div class="observation" data-view-mode="1"><div class="screen" data-angle="1"><video preload="metadata" muted playsinline src="/inspection/episode.mp4" poster="/inspection/start.webp" aria-label={t("Synchronized camera, depth and trajectory observations","同步相机、深度和轨迹观测")}></video></div>
<figure class="floorplan">
<figcaption>{t("Inspection route","巡检路线")} <small>{t("Top view · metres","俯视 · 米")}</small></figcaption>
<svg viewBox="0 0 350 272" role="img" aria-label={t("Measured path and pelvis heading around the warehouse racks","货架周围的实测路线与骨盆朝向")}>
<defs><pattern id="warehouse-grid" x="60" y="4" width="39" height="39" patternUnits="userSpaceOnUse"><path d="M39 0H0V39" fill="none" stroke="#d2d6dc"/></pattern></defs>
<rect width="350" height="272" fill="url(#warehouse-grid)"/>
{run.racks.map(([,x,y,hx,hy])=><rect x={px(+x-Number(hx))} y={py(+y+Number(hy))} width={+hx*78} height={+hy*78} rx="3" fill="#8c98a6"/>)}
<polyline points={itinerary.map(([x,y])=>[px(x),py(y)].join(",")).join(" ")} fill="none" stroke="#ba4d39" stroke-width="2" stroke-dasharray="5 4"/>
{run.route.filter(r=>Number(r[3])>0).map(([name,x,y])=>{
  const sec=Number(run.events.find(e=>e[0]===name)![1]);
  return <a class="map-stop" href={`?view=ego&t=${sec}#scene`} data-map-event={sec} data-station={name} aria-label={`${stations[name]} · ${sec} s`}>
    <title>{stations[name]} · {sec} s</title>
    <circle cx={px(+x)} cy={py(+y)} r="13" fill="transparent"/>
    <circle cx={px(+x)} cy={py(+y)} r="5" fill="white" stroke="#8c473b" stroke-width="2"/>
    <text x={px(+x)} y={py(+y)+18} text-anchor="middle">{stations[name]}</text>
  </a>})}
<circle data-event-location r="9" fill="#e7664233" stroke="#bf4e31" stroke-width="1.8" visibility="hidden" pointer-events="none"/>
<polyline data-path fill="none" stroke="#234fbb" stroke-width="3" stroke-linecap="round"/>
<path data-pelvis transform="translate(60 199)" d="M10 0 -6 -6 -3 0 -6 6Z" stroke="white" stroke-width="1.5" fill="#184399"/>
</svg>
<div class="keys"><span>{t("Planned","计划")}</span><span>{t("Measured","实测")}</span></div></figure></div>
<div class="replay-controls">
  <div class="replay-head"><button data-episode-play>{t("Play","播放")}</button><output>0.00 / {run.duration} s</output>
    <label class="cue-menu"><select data-jump aria-label={t("Jump to an event","跳至巡检节点")}>
      <option value="0">{t("Departure","开始巡检")}</option>
      {milestones.map(([name,time])=><option data-name={name} value={time}>{labels[name]} · {Number(time).toFixed(2)} s</option>)}
    </select></label>
  </div>
  <div class="ruler">
    <input type="range" step=".02" min="0" max={run.duration} value="0" aria-label={t("Trial time","执行时间")}/>
    <div class="marks">{milestones.map(([name,time])=>{
      const pos=Number(time)/run.duration*100;
      return stations[name]?<button data-name={name} data-event={time} style={`left:${pos}%`} title={labels[name]} aria-label={`${labels[name]} · ${time} s`}>
        <span>{stations[name]}</span><small>{Number(time).toFixed(2)} s</small></button>:
        <i data-name={name} style={`left:${pos}%`} aria-hidden="true"></i>
    })}</div>
  </div>
</div>
<p class="readout" data-measure></p>
<details class="source-note"><summary>{t("About this run","录制信息")}</summary>
<p data-policy>{t("G1 follows a walking cycle with its a45k tracker.","G1 使用自身的 a45k 策略跟踪步态。")}</p>
<p data-contact>{t("Rack contact samples","货架接触采样数")} · {run.clearance.rackContactSamples} / {run.clearance.samples}</p></details>
</section>
<script>
for(const root of document.querySelectorAll<HTMLElement>("[data-episode]")){
  const video=root.querySelector("video")!, slider=root.querySelector<HTMLInputElement>("input[type=range]")!,play=root.querySelector<HTMLButtonElement>("[data-episode-play]")!,en=root.dataset.lang==="en";
  const screen=root.querySelector<HTMLElement>(".screen")!;
  const angle=root.querySelector<HTMLSelectElement>("[data-angle]")!;
  const model=root.querySelector("omega-model-switch")!;
  let pending:number|null=null,resume=false;
  const profiles=JSON.parse(root.dataset.profiles!) as Record<string,{duration:number;cues:[string,number][];samples:number;contacts:number}>;
  const labels=JSON.parse(root.dataset.labels!),stations=JSON.parse(root.dataset.stations!);
  model.onchange=()=>{
    const id=model.value, a3=id==="a3",profile=profiles[id];
    resume=pending===null?!video.paused:resume;
    pending=Math.min(profile.duration,pending??video.currentTime);
    slider.max=String(profile.duration);
    video.pause();
    record=undefined;
    root.querySelector("[data-path]")!.setAttribute("points","");
    root.querySelector("[data-event-location]")!.setAttribute("visibility","hidden");
    root.querySelector("[data-measure]")!.textContent="";
    const departure=jump.options[0];
    jump.replaceChildren(departure,...profile.cues.map(([key,sec])=>new Option(labels[key]+" · "+sec.toFixed(2)+" s",String(sec))));
    for(const [key,sec] of profile.cues){
      const mark=root.querySelector<HTMLElement>(`.marks [data-name="${key}"]`);
      if(mark){
        mark.style.left=(100*sec/profile.duration)+"%";
        if(mark instanceof HTMLButtonElement){
          mark.dataset.event=String(sec);mark.setAttribute("aria-label",labels[key]+" · "+sec+" s");
          mark.querySelector("small")!.textContent=sec.toFixed(2)+" s";
        }
      }
      const stop=root.querySelector<SVGAElement>(`[data-station="${key}"]`);
      if(stop){
        const caption=stations[key]+" · "+sec+" s";
        stop.dataset.mapEvent=String(sec);stop.setAttribute("href",`?body=${id}&view=ego&t=${sec}#scene`);
        stop.setAttribute("aria-label",caption);stop.querySelector("title")!.textContent=caption;
      }
    }
    video.poster=a3?"/inspection/a3-start.webp":"/inspection/start.webp";
    video.src=a3?"/inspection/a3.mp4":"/inspection/episode.mp4";
    root.querySelector("[data-kind]")!.textContent=id.toUpperCase()+(en?" · Recorded physics trial":" · 物理执行记录");
    root.querySelector("[data-policy]")!.textContent=a3?(en?"A3 follows a retargeted gait with its own a15k tracker.":"A3 使用自身的 a15k 策略跟踪重定向步态。"):(en?"G1 follows a walking cycle with its a45k tracker.":"G1 使用自身的 a45k 策略跟踪步态。");
    root.querySelector("[data-contact]")!.textContent=(en?"Rack contact samples":"货架接触采样数")+" · "+profile.contacts+" / "+profile.samples;
    video.load();
    loadRecord(id);refresh();
  };
  video.addEventListener("loadedmetadata",()=>{
    if(pending===null)return;
    video.currentTime=pending;
    pending=null;
    if(resume)void video.play().catch(()=>{});
  });
  const observation=root.querySelector<HTMLElement>(".observation")!;
  angle.onchange=()=>{screen.dataset.angle=observation.dataset.viewMode=angle.value;};
  const query=new URLSearchParams(location.search);
  const view=["chase","ego","depth","map","all"].indexOf(query.get("view")||"ego");
  if(view>=0)screen.dataset.angle=observation.dataset.viewMode=angle.value=String(view);
  const time=Number(query.get("t"));
  if(Number.isFinite(time) && time>0){
    const openAt=()=>{video.currentTime=Math.min(time,Number(slider.max));};
    if(video.readyState>=1)openAt();else video.addEventListener("loadedmetadata",openAt,{once:true});
  }
  let record:{hz?:number;duration:number;commands:number[][];heading:number[];route:(number|string)[][];xy:number[][]}|undefined;
  const jump=root.querySelector<HTMLSelectElement>("[data-jump]")!;
  const markerButtons=root.querySelectorAll<HTMLButtonElement>("[data-event]");
  jump.onchange=()=>seek(Number(jump.value));
  root.querySelectorAll<SVGAElement>("[data-map-event]").forEach(a=>a.onclick=e=>{
    e.preventDefault();seek(Number(a.dataset.mapEvent));
  });
  const refresh=()=>{
    const sec=Math.min(pending??video.currentTime,Number(slider.max));slider.value=String(sec);
    root.querySelector(".replay-controls output")!.textContent=sec.toFixed(2)+" / "+slider.max+" s";
    if(!record)return;
    const frame=Math.min(Math.floor(sec*25),record.xy.length-1),xy=record.xy[frame];
    const cmd=record.commands.filter(c=>c[0]<=sec*50).at(-1);
    const heading=record.heading[frame],points=record.xy.slice(0,frame+1).map(([x,y])=>[60+39*x,199-39*y].join(","));
    root.querySelector("[data-path]")!.setAttribute("points",points.join(" "));
    root.querySelector("[data-pelvis]")!.setAttribute("transform",`translate(${points.at(-1)}) rotate(${-heading})`);
    const cue=[...jump.options].reverse().find(o=>Number(o.value)<=sec+.001)!;
    if(jump.value!==cue.value)jump.value=cue.value;
    const lastMajor=[...markerButtons].reverse().find(b=>Number(b.dataset.event)<=sec+.001);
    markerButtons.forEach(b=>{if(b===lastMajor)b.setAttribute("aria-current","step");else b.removeAttribute("aria-current")});
    const checkpoint=record.xy[Math.min(Math.floor(Number(cue.value)*25+.00001),record.xy.length-1)];
    const ring=root.querySelector("[data-event-location]")!;
    ring.setAttribute("visibility",Number(cue.value)>0?"visible":"hidden");
    ring.setAttribute("cx",String(60+39*checkpoint[0]));ring.setAttribute("cy",String(199-39*checkpoint[1]));
    slider.style.setProperty("--played",String(sec*100/Number(slider.max))+"%");
    const target=record.route[cmd?.[3]??0];
    const speed=frame?Math.hypot(xy[0]-record.xy[frame-1][0],xy[1]-record.xy[frame-1][1])*25:0;
    root.querySelector("[data-measure]")!.textContent=model.value.toUpperCase()+(en?" pelvis heading ":" 骨盆朝向 ")+Math.round((heading%360+540)%360-180)+"°　 ·　 "+(en?"Ground speed ":"实测地速 ")+speed.toFixed(2)+" m/s　 ·　 "+(en?"Distance to waypoint ":"距当前途经点 ")+Math.hypot(Number(target[1])-xy[0],Number(target[2])-xy[1]).toFixed(2)+" m";

  };
  function loadRecord(id:string){
    fetch(id==="a3"?"/inspection/a3-record.json":"/inspection/record.json").then(r=>r.json()).then(data=>{
      if(model.value===id){record=data;refresh();}
    }).catch(()=>{});
  }
  if(query.get("body")==="a3"){
    model.value="a3";model.dispatchEvent(new Event("change"));
    if(Number.isFinite(time)&&time>0)pending=Math.min(time,Number(slider.max));
  }else loadRecord("g1");
  play.onclick=()=>{if(video.paused){if(video.ended)video.currentTime=0;void video.play().catch(()=>{});}else video.pause();};
  video.onplay=()=>play.textContent=en?"Pause":"暂停";video.onpause=()=>play.textContent=en?"Play":"播放";
  function seek(t:number){
    video.pause();resume=false;
    if(video.readyState<1)pending=t;
    else {pending=null;video.currentTime=t;}
    refresh();
  }
  slider.oninput=()=>seek(Number(slider.value));
  root.querySelectorAll<HTMLButtonElement>("[data-event]").forEach(b=>b.onclick=()=>seek(Number(b.dataset.event)));
  if("requestVideoFrameCallback" in video){
    const onFrame=()=>{refresh();video.requestVideoFrameCallback(onFrame);};video.requestVideoFrameCallback(onFrame);
  }
  video.ontimeupdate=refresh;video.onseeked=refresh;
}
</script>
<style>
.episode[data-live-open] .observation,.episode[data-live-open] .replay-controls,.episode[data-live-open] .readout,.episode[data-live-open] .source-note,.episode[data-live-open] .view-controls>label,.episode[data-live-open] [data-kind]{display:none}

.episode{margin:12px 0 26px}.episode header,.transport,.events{display:flex;align-items:center;gap:10px}.episode header{justify-content:space-between;gap:20px;margin-bottom:15px}.episode h2{font-size:clamp(24px,3vw,42px);letter-spacing:-.045em}.episode header p,.readout{font-size:14px;color:var(--muted)}.episode select,.episode button{background:var(--paper);color:var(--fg);border:1px solid var(--rule);padding:8px 12px;border-radius:7px}.screen{position:relative;overflow:hidden;aspect-ratio:640/352;border-radius:10px;background:var(--tint)}.screen video{position:absolute;width:200%;max-width:none;height:200%;inset:0 auto auto 0}.screen[data-angle="1"] video,.screen[data-angle="3"] video{left:-100%}.screen[data-angle="2"] video,.screen[data-angle="3"] video{top:-100%}.screen[data-angle="4"] video{width:100%;height:100%}.transport{margin:14px 0}.transport button{background:var(--accent);color:var(--bg)}.transport input{min-width:0;flex:1;accent-color:var(--accent)}.transport output,.events small{font-variant-numeric:tabular-nums}.events{flex-wrap:wrap}.events small{color:var(--muted)}.readout,.source-note{margin-top:12px}.source-note{font-size:13px;color:var(--muted)}@media(max-width:550px){.episode header{align-items:start;flex-direction:column}.transport output{font-size:12px}.events button{font-size:12px}}
.observation{display:grid;align-items:stretch;overflow:hidden;border-radius:10px}.observation[data-view-mode="1"]{grid-template-columns:minmax(0,1.65fr) minmax(0,1fr)}.screen{border-radius:0}.floorplan{display:none;margin:0;background:#eef0f2;color:#202736;padding:12px;min-width:0}.observation[data-view-mode="1"] .floorplan{display:flex;flex-direction:column;justify-content:center}.floorplan svg{width:100%;min-height:0;flex:1;height:0}.floorplan text{font:12px system-ui;fill:#283447;paint-order:stroke;stroke:#eef0f2;stroke-width:3px}.floorplan figcaption,.keys{display:flex;align-items:center;justify-content:space-between;gap:9px;font-weight:600}.floorplan small,.keys{font-size:12px;color:#48525e}.keys{justify-content:flex-start}.keys span:before{content:"";display:inline-block;width:17px;border-top:2px dashed #ba4d39;margin-right:5px;vertical-align:middle}.keys span+span:before{border-top:3px solid #234fbb}@media(max-width:680px){.observation[data-view-mode="1"]{grid-template-columns:1fr}.floorplan svg{flex:none;height:clamp(185px,54vw,248px)}.floorplan{padding:8px 12px}}
.events [aria-current="step"]{color:var(--fg);border-color:var(--accent);box-shadow:inset 0 -2px var(--accent)}
.view-controls{display:flex;flex-wrap:wrap;gap:12px}.view-controls label{display:grid;gap:4px;font-size:12px;color:var(--muted)}

.replay-controls{margin:0 0 16px;border-bottom:1px solid var(--rule);padding:14px 4px 8px}
.replay-head{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.episode [data-episode-play]{border:0;border-radius:20px;background:var(--fg);color:var(--bg);min-width:68px;font-weight:600}
.replay-head output{font:13px var(--mono);color:var(--muted)}.cue-menu{margin-left:auto;max-width:100%}
.ruler{position:relative;margin:10px 8px 0;height:67px}.ruler input{width:calc(100% + 14px);position:absolute;left:-7px;top:0;height:22px;margin:0;background:transparent;appearance:none;accent-color:var(--accent);z-index:2;cursor:ew-resize}
.ruler input::-webkit-slider-runnable-track{height:3px;border-radius:2px;background:linear-gradient(to right,var(--accent) var(--played,0%),var(--rule) 0)}
.ruler input::-webkit-slider-thumb{appearance:none;width:14px;height:14px;margin-top:-5.5px;background:var(--accent);border:2px solid var(--bg);border-radius:50%;box-shadow:0 0 0 1px var(--accent)}
.ruler input::-moz-range-track{height:3px;background:var(--rule)}.ruler input::-moz-range-progress{height:3px;background:var(--accent)}
.marks{position:absolute;inset:21px 0 0}.marks i,.marks button:before{position:absolute;top:-6px;height:9px;width:1px;background:var(--muted)}.marks button:before{content:"";left:50%;height:7px;width:2px;background:var(--accent)}
.episode .marks button{position:absolute;top:0;transform:translateX(-50%);background:none;border:0;padding:5px 0;text-align:center;border-radius:3px;display:grid;gap:2px;font-size:12px;white-space:nowrap;font-weight:550}
.episode .marks button:last-child{transform:translateX(-100%);text-align:right}.marks button:last-child:before{left:auto;right:0}
.marks small{font:10px var(--mono);color:var(--muted)}.marks [aria-current],.marks button:hover{color:var(--accent)}
.map-stop:hover circle:nth-of-type(2),.map-stop:focus circle:nth-of-type(2){fill:#c44a2e;stroke:white}
@media(max-width:650px){.ruler{height:51px}.marks button span{display:none}.marks small{font-size:9px}.replay-head{gap:6px}.replay-head output{font-size:11px}.episode .cue-menu select{font-size:12px}.episode [data-episode-play]{min-width:48px}.episode .marks button{min-height:26px}}
</style>
