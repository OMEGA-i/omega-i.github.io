---
import type { Lang } from "../content";
const { lang } = Astro.props as { lang: Lang };
const en = lang === "en";
const overview = en
  ? [
      [
        "Task intent",
        "Choose a goal and define success.",
        "Task & constraints",
      ],
      [
        "Motion planning",
        "Select a skill or generate a whole-body reference.",
        "Motion reference",
      ],
      [
        "Feedback control",
        "Use the current body state to track the reference.",
        "Joint commands",
      ],
      [
        "Environment",
        "Execute the action and observe what changed.",
        "Observed outcome",
      ],
    ]
  : [
      ["任务意图", "确定要完成的任务，以及怎样算完成。", "目标与约束"],
      ["动作规划", "选择技能，或生成可供跟踪的全身动作。", "运动参考"],
      ["反馈控制", "根据身体的实时状态，跟踪期望姿态。", "关节控制量"],
      ["环境交互", "执行动作，观察身体和场景发生的变化。", "执行结果"],
    ];
---

<section
  class="system"
  id="architecture"
  aria-labelledby="system-title"
  data-system
>
  <header class="system-head">
    <div>
      <h2 id="system-title">
        {en ? "From intent to action" : "从任务意图到机器人行动"}
      </h2>
      <p>
        {en
          ? "How we organize planning, control and learning from interaction."
          : "我们如何分工做规划、控制，并从交互中学习。"}
      </p>
    </div>

  </header>
  <div class="plate" data-figure>
    <ol class="flow">
      {overview.map((node, i) => (
        <li>
          <svg
            class="glyph"
            viewBox="0 0 150 60"
            fill="none"
            aria-hidden="true"
          >
            {i === 0 && (
              <>
                <path
                  d="M13 47h38l19-27h45"
                  stroke="currentColor"
                  stroke-width="2"
                />
                <path
                  d="M49 47h26l14-11h27"
                  stroke="currentColor"
                  stroke-dasharray="3 4"
                />
                <circle cx="14" cy="47" r="4" fill="currentColor" />
                <circle cx="115" cy="20" r="10" stroke="currentColor" />
                <circle cx="115" cy="20" r="4" fill="currentColor" />
              </>
            )}
            {i === 1 && (
              <>
                {[0, 1, 2].map((j) => (
                  <path
                    d={`M10 ${47 - j * 6} C40 56, 55 ${5 + j * 5}, 84 ${22 + j * 5} S108 48,138 ${10 + j * 7}`}
                    stroke="currentColor"
                    stroke-width={j === 0 ? 2 : 1}
                    opacity={1 - j * 0.25}
                  />
                ))}
                <circle cx="10" cy="47" r="3" fill="currentColor" />
              </>
            )}
            {i === 2 && (
              <>
                <path
                  d="M23 39h22l18-20 16 29 16-22 11 10h27"
                  stroke="currentColor"
                  stroke-width="2.2"
                />
                <path
                  d="M23 39c24 0 24 0 39-13s12 31 31 8 11 10 40 1"
                  stroke="currentColor"
                  stroke-dasharray="3 3"
                />
                <path d="M12 10v42h128" stroke="currentColor" opacity=".32" />
              </>
            )}
            {i === 3 && (
              <>
                <path
                  d="m14 36 57-21 63 18-57 22Z M37 28l65 19 M61 20l65 19 M34 42l61-20 M59 50l60-22"
                  stroke="currentColor"
                  opacity=".42"
                />
                <path
                  d="m36 38 29-10 23 6 24-9"
                  stroke="currentColor"
                  stroke-width="2"
                />
                <circle cx="36" cy="38" r="3" fill="currentColor" />
                <circle cx="112" cy="25" r="4" fill="currentColor" />
              </>
            )}
          </svg>
          <div>
            <h3>{node[0]}</h3>
            <p>{node[1]}</p>
            <small>{node[2]}</small>
          </div>

        </li>
      ))}
    </ol>
    <div class="loop">
      <span aria-hidden="true">↶</span>
      <span>
        {en
          ? "Body state and task outcome feed back into control and planning"
          : "身体状态与任务结果反馈给控制和规划"}
      </span>

    </div>
  </div>
  <div class="system-notes">
    <div>
      <strong>{en ? "Motion representation" : "动作表示"}</strong>
      <p>
        {en
          ? "SeMoCo studies how to encode meaning and pose detail in human motion."
          : "SeMoCo 研究人体动作的语义与姿态细节如何编码。"}
      </p>
      <a href={"/" + lang + "/projects/semoco/"}>SeMoCo ↗</a>
    </div>
    <div>
      <strong>{en ? "Learning from interaction" : "从交互中持续学习"}</strong>
      <span class="planned">{en ? "Research direction" : "研究方向"}</span>
      <ol class="learning">
        {(en
          ? ["Record experience", "Evaluate", "Update policy"]
          : ["记录经验", "独立评估", "更新策略"]
        ).map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <p>
        {en
          ? "The next run tests whether the updated policy improves on the same task."
          : "在下一轮运行中检验，更新后的策略能否把同一项任务做得更好。"}
      </p>
    </div>
  </div>
</section>
<style>
  .system {
    margin-top: clamp(48px, 6vw, 86px);
    scroll-margin-top: 24px;
  }
  .system-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 22px;
  }
  .system-head h2 {
    font-size: clamp(26px, 3.25vw, 49px);
    letter-spacing: -0.055em;
    line-height: 1.15;
    font-weight: 560;
  }
  .system-head p,
  .system-notes p {
    color: var(--muted);
    margin-top: 8px;
  }
  .plate {
    padding: clamp(20px, 3.3vw, 56px);
    border-radius: 15px;
    background-color: var(--tint);
    background-image: radial-gradient(#618ad121 1px, transparent 1px);
    background-size: 12px 12px;
    color: var(--fg);
  }
  .flow {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2.7vw, 46px);
  }
  .flow li {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: start;
  }
  .flow li:not(:last-child):after {
    content: "→";
    position: absolute;
    right: calc(-1 * clamp(14px, 2vw, 30px));
    top: 20px;
    font-size: 21px;
    color: var(--muted);
  }
  .glyph {
    width: min(100%, 150px);
    height: 60px;
    color: var(--accent);
    margin: 0 0 13px;
  }
  .flow li:nth-child(2) .glyph {
    color: var(--accent);
  }
  .flow li:nth-child(3) .glyph {
    color: var(--accent);
  }
  .flow li:nth-child(4) .glyph {
    color: var(--signal);
  }
  .flow li > div {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .flow h3 {
    font-size: clamp(18px, 1.65vw, 27px);
    letter-spacing: -0.025em;
  }
  .flow p {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
    margin: 9px 0 16px;
    max-width: 27ch;
  }
  .flow small {
    font: 500 14px/1.45 var(--font);
    color: var(--accent);
    margin-top: auto;
  }
  .loop {
    border: 1px dashed var(--rule);
    border-top: 0;
    margin: 21px 7% 0;
    padding: 13px 10px 0;
    text-align: center;
    color: var(--fg);
    font-size: 15px;
    border-radius: 0 0 10px 10px;
  }
  .loop span {
    position: relative;
    background: var(--tint);
    padding: 0 6px;
    top: 9px;
  }
  .system-notes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    border-bottom: 1px solid var(--rule);
    padding: 22px 0;
  }
  .system-notes > div + div {
    border-left: 1px solid var(--rule);
    padding-left: 32px;
  }
  .system-notes strong {
    font-size: 17px;
  }
  .system-notes p {
    font-size: 15px;
    max-width: 62ch;
  }
  .system-notes a {
    display: inline-block;
    color: var(--accent);
    margin-top: 9px;
    font-size: 14px;
  }

  @media (max-width: 750px) {
    .system-head {
      align-items: start;
      flex-direction: column;
    }
    .flow {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .flow li {
      display: grid;
      grid-template-columns: 62px minmax(0, 1fr);
      gap: 17px;
      padding: 16px 0;
    }
    .flow li + li {
      border-top: 1px solid var(--rule);
    }
    .glyph {
      width: 62px;
      height: 48px;
      margin: 0;
    }
    .flow p {
      max-width: none;
      margin: 4px 0 6px;
    }
    .flow li:not(:last-child):after {
      content: "↓";
      left: 27px;
      right: auto;
      top: auto;
      bottom: -10px;
      background: var(--tint);
      font-size: 15px;
      z-index: 1;
    }
    .loop {
      margin: 10px 0 0;
    }
    .system-notes {
      gap: 18px;
    }
    .system-notes > div + div {
      padding-left: 18px;
    }
  }
  @media (max-width: 480px) {
    .system-notes {
      grid-template-columns: 1fr;
    }
    .system-notes > div + div {
      border-left: 0;
      padding-left: 0;
    }
    .system-head p {
      font-size: 15px;
    }
  }
  .planned {
    margin-left: 10px;
    font: 11px var(--mono);
    color: var(--muted);
  }
  .learning {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
  }
  .learning li {
    font-size: 13px;
    color: var(--accent);
  }
  .learning li + li:before {
    content: "→";
    margin-right: 7px;
    color: var(--muted);
  }
</style>
