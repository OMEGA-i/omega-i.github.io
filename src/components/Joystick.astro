---
import ModelSwitch from "./ModelSwitch.astro";
const { lang = "en" } = Astro.props;
const zh = lang === "zh";
const live =
  import.meta.env.PUBLIC_JOYSTICK_MODEL_MANIFEST || __JOYSTICK_DEV_MODEL__;
---

<section
  class="motion-lab"
  data-joystick
  data-lang={lang}
  data-model={live}
  aria-label={zh ? "Joystick 动作演示" : "Joystick motion demo"}
>
  <div class="motion-stage">
    <div
      class="motion-view"
      data-view
      role="img"
      aria-label={
        zh ? "机器人三维动作回放，拖动旋转" : "Robot motion playback. Drag to orbit."
      }
    ></div>
    <video data-a3 muted playsinline preload="auto" hidden></video>
    <div class="stage-caption">
      <span class="mode-tag" data-mode>
        {zh ? "步态参考示意" : "Walking reference preview"}
      </span>
      <strong data-body-name>Unitree G1</strong>
    </div>
    <div class="line-key">
      <span>{zh ? "参考根轨迹" : "Reference root path"}</span>
      <span>{zh ? "指令方向" : "Velocity command"}</span>
    </div>
    <div class="time-bar">
      <button data-play type="button">
        {zh ? "播放" : "Play"}
      </button>
      <input
        data-frame
        type="range"
        min="0"
        max="59"
        step="1"
        value="36"
        aria-label={zh ? "逐帧查看" : "Scrub frames"}
      />
      <output data-time>1.44 s</output>
      <button data-follow type="button" aria-pressed="true">{zh ? "跟随镜头" : "Follow camera"}</button>
      <button data-reset-camera type="button">
        {zh ? "复位视角" : "Reset view"}
      </button>
    </div>
  </div>
  <div class="motion-panel">
<p>{zh ? "用公开步态演示速度指令和根轨迹。Joystick 模型的生成示例见源码仓库。" : "Explore velocity commands with a public walking reference. The repository includes the Joystick model generation example."} <a href="https://github.com/OMEGA-i/Joystick">GitHub ↗</a></p>
    <h2>{zh ? "速度指令" : "Velocity command"}</h2>
    <div class="command-row">
      <div class="direction-pad" data-pad aria-hidden="true">
        <span></span>
      </div>
      <div class="speed-inputs">
        <label>
          {zh ? "向前" : "Forward"} <small>m/s</small>
          <input
            data-vx
            type="number"
            min="-2"
            max="2"
            step=".01"
            value="0.8"
          />
        </label>
        <label>
          {zh ? "向左" : "Left"} <small>m/s</small>
          <input
            data-vy
            type="number"
            min="-2"
            max="2"
            step=".01"
            value="0.25"
          />
        </label>
      </div>
    </div>
    <label class="preset-label">
      {zh ? "样例指令" : "Sample commands"}
      <select data-preset>
        <option value="diagonal">
          {zh ? "斜向" : "Diagonal"} · 0.80 / 0.25
        </option>
        <option value="idle">{zh ? "静止" : "Idle"} · 0 / 0</option>
        <option value="forward">{zh ? "前进" : "Forward"} · 0.80 / 0</option>
        <option value="left">{zh ? "侧移" : "Sidestep"} · 0 / 0.35</option>
        <option value="backward">{zh ? "后退" : "Backward"} · −0.30 / 0</option>
      </select>
    </label>
    <button type="button" data-run>
      {live
        ? zh
          ? "生成动作"
          : "Generate motion"
        : zh
          ? "载入此指令的回放"
          : "Load command replay"}
    </button>
    <p class="motion-status" data-status role="status" aria-live="polite">
      {zh ? "加载生成的运动参考…" : "Loading the generated motion reference…"}
    </p>
<ModelSwitch control="data-body" label={zh?"回放本体":"Playback model"} recordedOnly />
    <p data-retarget hidden>{zh?"A3 使用本体步态参考。":"A3 uses its own walking reference."}</p>
    <p class="motion-spec">
      {zh
        ? "全身动作参考"
        : "Whole-body motion reference"}
    </p>
  </div>
</section>
<script>
  import { mountJoystick } from "../joystick/studio";
  document
    .querySelectorAll<HTMLElement>("[data-joystick]")
    .forEach(mountJoystick);
</script>
<style>
  [data-a3]{grid-column:1;grid-row:1;width:100%;height:100%;object-fit:contain;background:#dfe2e4;min-height:0;z-index:1}
  .motion-view{grid-column:1}
  [hidden]{display:none!important}
[data-follow][aria-pressed="true"]{text-decoration:underline;text-underline-offset:4px}
  .motion-lab {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(238px, 1fr);
    border: 1px solid color-mix(in srgb, currentColor 24%, transparent);
    border-radius: 14px;
    overflow: hidden;
    margin: 1.7rem 0 3rem;
    --teal: #214ec7;
    --orange: #b23627;
    font-family: inherit;
  }
  .motion-stage {
    position:relative;isolation:isolate;min-width:0;display:grid;
    grid-template-rows:minmax(340px,1fr) auto auto;
    background:#17242c;color:#ecf5f4;
  }
  .motion-view {
    grid-row:1;width:100%;min-height:340px;position:relative;touch-action:none;cursor:grab;
    background:#1b2932 url('/joystick/cover.webp') center / cover no-repeat;
  }
  .motion-view:active {cursor:grabbing;}
  .motion-view :global(canvas),.motion-view :global(video){
    position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover;
  }
  .stage-caption {
    position:absolute;z-index:1;left:16px;top:16px;display:flex;flex-direction:column;
    align-items:flex-start;gap:6px;pointer-events:none;color:#f2f7f5;
  }
  .stage-caption strong {font-size:1.05rem;letter-spacing:-.01em;line-height:1.1;}
  .mode-tag{
    border:1px solid #6785b0;border-radius:4px;padding:4px 7px;font-size:.82rem;
    font-weight:600;color:#edf4ff;background:#20395df2;
  }
  .line-key {
    grid-row:2;display:flex;gap:18px;flex-wrap:wrap;padding:9px 15px 6px;
    font-size:.85rem;background:var(--tint);color:var(--fg);border-top:1px solid var(--rule);
  }
  .line-key span {display:flex;align-items:center;gap:6px;}
  .line-key span::before {content:"";width:19px;border-top:3px solid var(--accent);}
  .line-key span+span::before {border-color:var(--signal);border-top-style:dashed;}
  .time-bar {
    grid-row:3;display:flex;align-items:center;gap:12px;padding:2px 10px 7px;
    background:var(--tint);color:var(--fg);min-width:0;
  }
  .time-bar input {min-width:15px;width:100%;accent-color:var(--accent);cursor:pointer;}
  .time-bar output {font:12px monospace;white-space:nowrap;}
  .time-bar button {
    font:inherit;font-size:.85rem;white-space:nowrap;background:transparent;
    color:inherit;border:0;padding:8px 5px;cursor:pointer;
  }
  .time-bar button:hover {color:var(--accent);}
  .time-bar, .line-key, .stage-caption {--teal:#84adff;--orange:#ff8978;}
  .motion-panel {
    padding: clamp(17px, 2.5vw, 29px);
    display: flex;
    flex-direction: column;
    gap: 15px;
    min-width: 0;
  }
  .motion-panel h2 {
    margin: 0;
    font-size: 1.36rem;
    letter-spacing: -0.035em;
  }
  .command-row {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 16px;
  }
  .direction-pad {
    position: relative;
    width: 86px;
    height: 86px;
    flex: none;
    touch-action: none;
    border-radius: 50%;
    border: 1px solid currentColor;
    background:
      radial-gradient(
        circle at center,
        transparent 49%,
        #5e7bac33 50%,
        transparent 51%
      ),
      linear-gradient(90deg, transparent 49%, #5e7bac66 50%, transparent 51%),
      linear-gradient(transparent 49%, #5e7bac66 50%, transparent 51%);
    cursor: crosshair;
  }
  .direction-pad span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--teal);
    border: 2px solid #fafbf8;
    box-shadow: 0 0 0 1px var(--teal);
    transform: translate(-50%, -50%);
  }
  .speed-inputs {
    display: grid;
    gap: 5px;
    flex: 1;
  }
  .motion-panel label {
    font-size: .88rem;
    display: block;
  }
  .motion-panel label small {
    opacity: 0.72;
  }
  .speed-inputs input,
  .preset-label select {
    width: 100%;
    min-width: 0;
    display: block;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    border-radius: 5px;
    margin-top: 3px;
    padding: 4px 7px;
  }
  .preset-label select {
    padding: 8px;
  }
  .preset-label option {
    background: Canvas;
    color: CanvasText;
  }
  .motion-panel [data-run] {
    border: 0;
    background: #214ec7;
    color: #fff;
    font: inherit;
    font-weight: 600;
    border-radius: 7px;
    padding: 10px;
    cursor: pointer;
  }
  .motion-panel [data-run]:disabled {
    opacity: 0.6;
  }
  .motion-status,
  .motion-spec {
    margin: 0 !important;
    font-size: 0.81rem !important;
    line-height: 1.4 !important;
  }
  .motion-spec {
    opacity: 0.68;
    margin-top: auto !important;
    font-size: 0.72rem !important;
  }
  @media (max-width: 760px) {
    .motion-lab {
      grid-template-columns: 1fr;
    }
    .motion-stage { grid-template-rows:minmax(295px,auto) auto auto; }
    .motion-view { min-height:295px; aspect-ratio:1.15; }
    .stage-caption { left:10px; top:10px; }
    .stage-caption strong { font-size:.88rem; }
    .motion-panel {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
    .motion-panel h2,
    .command-row,
    .motion-status,
    .motion-spec {
      grid-column: 1/-1;
    }
    .speed-inputs {
      grid-template-columns: 1fr 1fr;
    }
    .direction-pad {
      width: 70px;
      height: 70px;
    }
    .time-bar {
      gap: 5px;
    }
    .line-key {
      left: 10px;
    }
  }
</style>
